<?xml version="1.0" encoding="utf-8"?>
<!--
  网络安全配置：系统信任锚 + 附加 Sectigo R46 根证书。
  背景：555影视（5k35.top）的 ZeroSSL 证书链锚定在
  "Sectigo Public Server Authentication Root R46"（2021 年新增的根），
  部分 Android 系统证书库尚未收录该根，导致
  CertPathValidatorException: Trust anchor for certification path not found。
  打包该根证书后完整链可验证（leaf ← ZeroSSL RSA DV SSL CA 2 ← R46）。

  另：广告变现（Adsterra Direct Link）的落地页由投放方动态下发，
  常见为 http 明文域名（如 arkrecode16.ero-labs.global），
  且域名随广告计划变化无法预先白名单，故 base-config 放开 cleartextTrafficPermitted。
  本项目不传输用户账号/支付类敏感数据，该放宽风险可控。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/sectigo_r46" />
        </trust-anchors>
    </base-config>
</network-security-config>
