<?xml version="1.0" encoding="utf-8"?>
<!-- 「正在直播」横滑卡：暖橙到深灰渐变；焦点/按压橙色描边（TV 遥控器） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#5A2E1F"
                android:centerColor="#2A2228"
                android:endColor="#15171E" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="@color/accent" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#5A2E1F"
                android:centerColor="#2A2228"
                android:endColor="#15171E" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#42241A"
                android:centerColor="#241E24"
                android:endColor="#15171E" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#33FF6A3D" />
        </shape>
    </item>
</selector>
