<?xml version="1.0" encoding="utf-8"?>
<!-- 应用图标：暗色底 + 橙色播放三角（layer-list 兼容所有启动器） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="270"
                android:startColor="#1E222B"
                android:endColor="#0E0F14" />
            <stroke android:width="2dp" android:color="#2A2F3A" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_play_glyph"
        android:gravity="center" />
</layer-list>
